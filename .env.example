APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
DATABASE_URL=postgresql+asyncpg://food_ai:food_ai@postgres:5432/food_ai
REDIS_URL=redis://redis:6379/0
REDIS_PROFILE_TTL_SECONDS=900
REDIS_RECOMMENDATION_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=3600

MAIN_BACKEND_BASE_URL=http://host.docker.internal:8001
MAIN_BACKEND_TIMEOUT_SECONDS=5

LLM_PROVIDER=openai
OPENAI_API_KEY=
# Current OpenAI docs use gpt-5.6 in Responses API examples. Keep configurable.
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
GENERATIVE_RATE_LIMIT_PER_MINUTE=20

RECOMMENDATION_CANDIDATE_LIMIT=200
RECOMMENDATION_DEFAULT_LIMIT=20
